<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|README\.md|CHANGELOG\.md|LICENSE)$ - [F,L]

    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|tests|node_modules)/ - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|env\..*|log|sql|sqlite|bak|old|orig|swp|ini|yml|yaml|lock|dist)$">
    Require all denied
</FilesMatch>

Options -Indexes
