{
    "name": "Spotlight",
    "slug": "spotlight",
    "version": "1.0.2",
    "author": "RJ Nexus",
    "author_url": "https://github.com/rj-nexus",
    "description": "Dark, modern product showcase theme with builder-first architecture.",
    "license": "MIT",
    "preview": "https://raw.githubusercontent.com/rj-nexus/spotlight/main/screenshot.png",
    "namespace": "Spotlight",
    "provider": "Spotlight\\SpotlightServiceProvider",
    "requires": {
        "rj_cms": ">=1.0.0",
        "php": ">=8.2"
    },
    "supports": {
        "builder_header": true,
        "builder_footer": true,
        "builder_page": true,
        "builder_popup": true,
        "custom_logo": true,
        "custom_colors": true,
        "custom_fonts": true,
        "post_thumbnail": true,
        "post_excerpt": true,
        "menus": ["header", "footer", "mobile"]
    },
    "views": {
        "layout": "views/layout.blade.php",
        "single_post": "views/single-post.blade.php",
        "single_page": "views/single-page.blade.php",
        "archive": "views/archive.blade.php"
    },
    "custom_templates": [
        {
            "id": "contact",
            "label": "Contact Page",
            "description": "Two-column contact layout with form and info sidebar.",
            "view": "views/templates/contact.blade.php",
            "icon": "mail"
        },
        {
            "id": "landing",
            "label": "Landing Page",
            "description": "Full-width dark hero with centered CTA.",
            "view": "views/templates/landing.blade.php",
            "icon": "rocket"
        },
        {
            "id": "full-width",
            "label": "Full Width",
            "description": "Edge-to-edge content without container padding.",
            "view": "views/templates/full-width.blade.php",
            "icon": "expand"
        }
    ],
    "assets": {
        "css": [],
        "js": []
    },
    "customizer": {
        "sections": {
            "colors": {
                "label": "Colors",
                "icon": "palette",
                "controls": {
                    "primary_color": { "type": "color", "label": "Primary Color", "default": "#a78bfa" },
                    "secondary_color": { "type": "color", "label": "Secondary Color", "default": "#f472b6" },
                    "accent_color": { "type": "color", "label": "Accent Color", "default": "#22d3ee" },
                    "text_color": { "type": "color", "label": "Text Color", "default": "#e5e7eb" },
                    "muted_color": { "type": "color", "label": "Muted Text Color", "default": "#94a3b8" },
                    "background_color": { "type": "color", "label": "Background Color", "default": "#0a0a0f" },
                    "surface_color": { "type": "color", "label": "Surface Color", "default": "#14141c" },
                    "border_color": { "type": "color", "label": "Border Color", "default": "#262632" },
                    "link_color": { "type": "color", "label": "Link Color", "default": "#a78bfa" }
                }
            },
            "typography": {
                "label": "Typography",
                "icon": "type",
                "controls": {
                    "font_body": { "type": "select", "label": "Body Font", "default": "Inter", "options": { "Inter": "Inter", "Figtree": "Figtree", "Roboto": "Roboto", "Open Sans": "Open Sans", "Lato": "Lato", "Poppins": "Poppins", "system-ui": "System Default" } },
                    "font_heading": { "type": "select", "label": "Heading Font", "default": "Inter", "options": { "Inter": "Inter", "Figtree": "Figtree", "Roboto": "Roboto", "Open Sans": "Open Sans", "Lato": "Lato", "Poppins": "Poppins", "system-ui": "System Default" } },
                    "font_size_base": { "type": "range", "label": "Base Font Size", "default": 16, "min": 12, "max": 24, "step": 1, "suffix": "px" },
                    "line_height": { "type": "range", "label": "Line Height", "default": 1.65, "min": 1.2, "max": 2.2, "step": 0.05 }
                }
            },
            "layout": {
                "label": "Layout",
                "icon": "layout",
                "controls": {
                    "container_width": { "type": "range", "label": "Container Width", "default": 1200, "min": 960, "max": 1600, "step": 20, "suffix": "px" },
                    "sidebar_position": { "type": "select", "label": "Sidebar Position", "default": "right", "options": { "right": "Right", "left": "Left", "none": "No Sidebar" } },
                    "sticky_header": { "type": "toggle", "label": "Sticky Header", "default": true }
                }
            },
            "blog_list": {
                "label": "Blog List (Archive)",
                "icon": "list",
                "controls": {
                    "show_excerpt": { "type": "toggle", "label": "Show Excerpt in Cards", "default": true },
                    "columns": { "type": "select", "label": "Grid Columns", "default": "2", "options": { "1": "1 Column", "2": "2 Columns", "3": "3 Columns" } },
                    "background_video": { "type": "text", "label": "Background Video URL", "default": "https://raw.githubusercontent.com/rj-nexus/spotlight/main/assets/video/background.mp4" }
                }
            },
            "blog_single": {
                "label": "Blog Details (Single)",
                "icon": "document",
                "controls": {
                    "show_featured_image": { "type": "toggle", "label": "Show Featured Image", "default": true },
                    "show_related_posts": { "type": "toggle", "label": "Show Related Posts", "default": true },
                    "background_video": { "type": "text", "label": "Background Video URL", "default": "https://raw.githubusercontent.com/rj-nexus/spotlight/main/assets/video/background.mp4" }
                }
            },
            "single_page": {
                "label": "Static Pages",
                "icon": "page",
                "controls": {
                    "show_featured_image": { "type": "toggle", "label": "Show Featured Image", "default": true },
                    "content_width": { "type": "select", "label": "Content Width", "default": "normal", "options": { "normal": "Normal (900px)", "wide": "Wide (1100px)", "full": "Full Width" } },
                    "background_video": { "type": "text", "label": "Background Video URL", "default": "https://raw.githubusercontent.com/rj-nexus/spotlight/main/assets/video/background.mp4" }
                }
            },
            "header": {
                "label": "Header",
                "icon": "header",
                "controls": {
                    "logo_text": { "type": "text", "label": "Logo Text", "default": "Spotlight" },
                    "logo_image": { "type": "text", "label": "Logo Image URL", "default": "https://github.com/rj-nexus/spotlight/screenshot.png" },
                    "header_bg": { "type": "color", "label": "Header Background", "default": "#0a0a0f" },
                    "header_text_color": { "type": "color", "label": "Header Text Color", "default": "#f1f5f9" }
                }
            },
            "footer": {
                "label": "Footer",
                "icon": "footer",
                "controls": {
                    "footer_text": { "type": "textarea", "label": "Footer Text", "default": "© 2026 Spotlight. All rights reserved." },
                    "footer_bg": { "type": "color", "label": "Footer Background", "default": "#050508" },
                    "footer_text_color": { "type": "color", "label": "Footer Text Color", "default": "#94a3b8" }
                }
            },
            "social": {
                "label": "Social Links",
                "icon": "link",
                "controls": {
                    "facebook": { "type": "url", "label": "Facebook URL", "default": "" },
                    "twitter": { "type": "url", "label": "Twitter / X URL", "default": "" },
                    "instagram": { "type": "url", "label": "Instagram URL", "default": "" },
                    "youtube": { "type": "url", "label": "YouTube URL", "default": "" },
                    "linkedin": { "type": "url", "label": "LinkedIn URL", "default": "" },
                    "github": { "type": "url", "label": "GitHub URL", "default": "" }
                }
            }
        }
    }
}